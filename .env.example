# Copy to .env and fill in. Never commit .env.

# dev | test | prod  (prod refuses to start without RIA_API_KEYS and RIA_ADMIN_API_KEY)
RIA_ENV=dev
# Load data/sample into an empty database on start-up
RIA_SEED_SAMPLE_DATA=true
# Default is SQLite in ./data; for production use PostgreSQL:
# RIA_DATABASE_URL=postgresql+psycopg://user:pass@host:5432/ria

# Model provider: nvidia (default) | openai | anthropic | google | openrouter | offline (no key, local runs only)
RIA_LLM_PROVIDER=nvidia
RIA_LLM_MODEL=nvidia/nemotron-3-super-120b-a12b
# Free API key from build.nvidia.com
NVIDIA_API_KEY=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
# Nemotron thinking mode: false = faster answers (default), true = more careful on hard questions
RIA_LLM_REASONING=false
RIA_LLM_MAX_TOKENS=1024
# For OpenAI:     RIA_LLM_PROVIDER=openai, RIA_LLM_MODEL=gpt-4.1-mini, OPENAI_API_KEY=...
# For Anthropic:  RIA_LLM_PROVIDER=anthropic, RIA_LLM_MODEL=claude-sonnet-4-5, ANTHROPIC_API_KEY=...
# For Google:     RIA_LLM_PROVIDER=google, RIA_LLM_MODEL=gemini-2.5-flash, GOOGLE_API_KEY=...
# For OpenRouter: RIA_LLM_PROVIDER=openrouter and RIA_LLM_API_KEY=...
# Prices in USD per 1M tokens for cost tracking (0 on NVIDIA's free tier; tokens are still counted)
RIA_LLM_INPUT_COST_PER_MTOK=0
RIA_LLM_OUTPUT_COST_PER_MTOK=0

# API access: comma-separated client keys and one admin key (long random strings)
RIA_API_KEYS=
RIA_ADMIN_API_KEY=
RIA_RATE_LIMIT_PER_MINUTE=30

# Observability: none | console | otlp
RIA_LOG_LEVEL=INFO
RIA_OTEL_EXPORTER=none
# RIA_OTEL_ENDPOINT=http://localhost:4318/v1/traces
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
